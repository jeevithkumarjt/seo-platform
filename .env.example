# Copy to .env and fill in. ALL free-tier only. No paid keys.
DATABASE_URL=postgresql://wip:wip@db:5432/wip
REDIS_URL=redis://redis:6379/0
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Free Google APIs (all free tier)
PAGESPEED_API_KEY=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# Free alerting (pick one or both)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional: free-tier LLM sampling for AEO/GEO (or self-hosted Ollama)
# Leave blank to mark AEO checks as unavailable (correct behavior).
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
